{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:saddle:schema:verified-intent-binding:0.1",
  "title": "Saddle VerifiedIntentBinding v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "content_hash",
    "intent_id",
    "intent_content_hash",
    "raw_intent_hash",
    "principal_ref",
    "origin_event",
    "status",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "saddle-verified-intent-binding/0.1"},
    "binding_id": {"type": "string", "pattern": "^verified-intent:sha256:[0-9a-f]{64}$"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "intent_id": {"type": "string", "pattern": "^intent:sha256:[0-9a-f]{64}$"},
    "intent_content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "raw_intent_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "principal_ref": {"type": "string", "minLength": 1},
    "origin_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "content_hash", "observed_at"],
      "properties": {
        "ref_id": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "observed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }
    },
    "status": {"enum": ["ACTIVE", "REVOKED", "EXPIRED"]},
    "issued_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
