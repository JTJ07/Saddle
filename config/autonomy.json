{
  "schema_version": "saddle-autonomy/0.1",
  "completion_lock": true,
  "levels": {
    "L0": {
      "name": "READ_ANALYZE",
      "autonomous": true
    },
    "L1": {
      "name": "SAFE_REVERSIBLE",
