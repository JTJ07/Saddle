{
  "schema_version": "saddle-autonomy/0.1",
  "completion_lock": false,
  "levels": {
    "L0": {
      "name": "READ_ANALYZE",
      "autonomous": true
    },
    "L1": {
      "name": "SAFE_REVERSIBLE",
      "autonomous": true,
      "conditions": [
        "inside_explicitly_delegated_scope",
        "reversible",
        "tested",
        "non_destructive"
      ]
    },
    "L2": {
      "name": "REPOSITORY_CHANGE",
      "autonomous": true,
      "conditions": [
        "explicitly_delegated_repository_change",
        "branch_scoped",
        "tests_required",
        "durable_handoff_required",
        "no_new_product_roadmap_without_human_decision"
      ]
    },
    "L3": {
      "name": "HUMAN_AUTHORITY",
      "autonomous": false,
      "examples": [
        "change_product_goal",
        "activate_new_product_roadmap",
        "change_completion_lock_state",
        "unscoped_merge_or_deploy",
        "expand_secrets_or_permissions",
        "high_risk_external_effect",
        "weaken_security_or_evidence",
        "promote_hypothesis_to_human_decision"
      ]
    }
  }
}
