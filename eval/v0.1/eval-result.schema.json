{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:saddle:schema:eval-result:0.1",
  "title": "Saddle Eval Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "lane_id", "case_id", "subject_ref", "result", "model", "prompt_version", "metrics", "scope_violations", "policy_violations", "evidence_refs", "started_at", "finished_at", "notes"],
  "properties": {
    "schema_version": {"const": "saddle-eval-result/0.1"},
    "run_id": {"type": "string", "pattern": "^eval:sha256:[0-9a-f]{64}$"},
    "lane_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "result": {"enum": ["PASS", "FAIL", "BLOCKED", "ERROR"]},
    "model": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["provider", "model_id"], "properties": {"provider": {"type": "string", "minLength": 1}, "model_id": {"type": "string", "minLength": 1}, "model_version": {"type": "string", "minLength": 1}}}
      ]
    },
    "prompt_version": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "input_tokens", "output_tokens", "cost_minor", "currency", "retries", "human_corrections"],
      "properties": {
        "latency_ms": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 9007199254740991}]},
        "input_tokens": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 9007199254740991}]},
        "output_tokens": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 9007199254740991}]},
        "cost_minor": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 9007199254740991}]},
        "currency": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Z]{3}$"}]},
        "retries": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "human_corrections": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "scope_violations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "policy_violations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "finished_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
