{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:saddle:schema:common:0.1",
  "title": "Saddle Protocol v0.1 Common Definitions",
  "$defs": {
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "kind"],
      "properties": {
        "ref_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["REPOSITORY", "COMMIT", "PULL_REQUEST", "ISSUE", "FILE", "URL", "EVIDENCE", "INTENT", "EFFECT", "RECEIPT", "STATE_DELTA", "OTHER"]},
        "uri": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "#/$defs/contentHash"},
        "observed_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "evidenceExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "verifier_ref": {"type": "string", "minLength": 1}
      }
    },
    "moneyLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount_minor", "currency"],
      "properties": {
        "amount_minor": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "authorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "authority_kind", "status", "binds_to", "source_refs", "issued_at"],
      "properties": {
        "authority_id": {"type": "string", "minLength": 1},
        "authority_kind": {"enum": ["HUMAN_DECISION", "REQUEST_ORIGIN", "EFFECT_PERMISSION", "POLICY", "BUDGET", "OTHER"]},
        "status": {"enum": ["ACTIVE", "REVOKED", "EXPIRED"]},
        "binds_to": {
          "type": "object",
          "additionalProperties": false,
          "required": ["object_type", "object_id", "content_hash"],
          "properties": {
            "object_type": {"enum": ["INTENT", "EFFECT", "CONTRACT", "OTHER"]},
            "object_id": {"type": "string", "minLength": 1},
            "content_hash": {"$ref": "#/$defs/contentHash"}
          }
        },
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "provider_ref": {"type": "string", "minLength": 1}
      }
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidence_refs"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "FAIL", "SKIPPED"]},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}
      }
    }
  }
}
